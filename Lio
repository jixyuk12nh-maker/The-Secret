local function safeToggle(id)
	local t = Toggles and Toggles[id]
	return t ~= nil and t.Value == true
end
local function safeOption(id, default)
	local o = Options and Options[id]
	if o == nil or o.Value == nil then return default end
	return o.Value
end

-- scales one cooldown field: keeps original in `store`, applies factor when on
local function scaleCooldown(store, obj, field, on, val, minV)
	if type(obj[field]) ~= "number" then return end
	if store[obj] == nil then store[obj] = obj[field] end
	if on then
		obj[field] = math.max(minV, store[obj] * (val / SPECIAL_BASE))
	else
		obj[field] = store[obj]
	end
end

local function applySpecialCooldowns()
	local ok, lib = pcall(function() return require(ReplicatedStorage.Modules.ItemLibrary) end)
	if not ok or not lib or type(lib.Items) ~= "table" then return end

	local scytheOn, scytheVal = safeToggle("ScytheDashToggle"), safeOption("ScytheDashSlider", SPECIAL_BASE)
	local axeOn, axeVal       = safeToggle("AxeSpinToggle"), safeOption("AxeSpinSlider", SPECIAL_BASE)
	local katanaOn, katanaVal = safeToggle("KatanaDeflectToggle"), safeOption("KatanaDeflectSlider", SPECIAL_BASE)
	local knifeOn, knifeVal   = safeToggle("KnifeHeavyToggle"), safeOption("KnifeHeavySlider", SPECIAL_BASE)
	local gunOn, gunVal       = safeToggle("FireCooldownEnabled"), safeOption("FireCooldownSlider", SPECIAL_BASE)
	local meleeOn, meleeVal   = safeToggle("MeleeCooldownEnabled"), safeOption("MeleeCooldownSlider", SPECIAL_BASE)

	local GUN_MIN, MELEE_MIN = 0.02, 0
	local S = SpecialCooldownOriginals

	local function apply(obj)
		scaleCooldown(S.DashCooldown,        obj, "DashCooldown",        scytheOn,  scytheVal, 0.001)
		scaleCooldown(S.SpinCooldown,        obj, "SpinCooldown",        axeOn,     axeVal,    0.001)
		scaleCooldown(S.DeflectCooldown,     obj, "DeflectCooldown",     katanaOn,  katanaVal, 0.001)
		scaleCooldown(S.HeavyAttackCooldown, obj, "HeavyAttackCooldown", knifeOn,   knifeVal,  0.001)
		scaleCooldown(S.ShootCooldown,       obj, "ShootCooldown",       gunOn,     gunVal,    GUN_MIN)
		scaleCooldown(S.AttackCooldown,      obj, "AttackCooldown",      meleeOn,   meleeVal,  MELEE_MIN)
	end

	for _, data in pairs(lib.Items) do
		if type(data) == "table" then apply(data) end
	end

	local fighter = getFighter()
	if fighter and type(fighter.Items) == "table" then
		for _, item in pairs(fighter.Items) do
			local info = itemField(item, "Info")
			if type(info) == "table" then apply(info) end
		end
	end
end

local function applySpeedBoost()
	if speedBoostOriginal ~= nil then return end
	local ok, lib = pcall(function() return require(ReplicatedStorage.Modules.ItemLibrary) end)
	if not ok or not lib or not lib.Items then return end
	speedBoostOriginal = {}
	local FIELDS = {
		"ShootCooldown", "ShootBurstCooldown", "ShootRecoil", "ShootSpread",
		"AttackCooldown", "AttackDelay", "SwingCooldown", "MeleeCooldown",
		"Cooldown", "RecoveryTime", "ResetTime", "SwingTime", "SwingDelay",
		"ComboCooldown", "FireCooldown", "ReloadLength",
	}
	local mult = Config.SpeedBoostMult
	for name, data in pairs(lib.Items) do
		if type(data) == "table" then
			local orig = {}
			for _, f in ipairs(FIELDS) do
				if data[f] ~= nil then
					orig[f] = data[f]
					if type(data[f]) == "number" then data[f] = data[f] * mult end
				end
			end
			if next(orig) ~= nil then speedBoostOriginal[name] = orig end
		end
	end
	if next(speedBoostOriginal) == nil then speedBoostOriginal = nil end
	getgenv().__MinhoRageSpeedBoost = speedBoostOriginal
end

