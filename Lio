-- ===== Halloween: auto-shoot (weapon logic from Minho Hub) =====
do
local repS = game:GetService("ReplicatedStorage")
local plrs = game:GetService("Players")
local runS = game:GetService("RunService")
local uis = game:GetService("UserInputService")
local ws = workspace
local lplr = plrs.LocalPlayer
local util = require(repS.Modules.Utility)
local enum = require(repS.Modules.EnumLibrary)
local FighterController = require(lplr.PlayerScripts.Controllers.FighterController)

local HALLOWEEN = {
	AutoShoot = true,
	FireRate = 0.05,
	WeaponSlot = "Primary",
	MaxDistance = 500,
	Debug = false,
}
local halloweenRunning = true

local function itemField(obj, key)
	if obj == nil then return nil end
	local ok, v = pcall(function() return obj[key] end)
	return ok and v or nil
end

local function getItems()
	local fighter = FighterController.LocalFighter
	local items = itemField(fighter, "Items")
	if type(items) == "table" then return items end
	return nil
end

local function getEquippedItem()
	local fighter = FighterController.LocalFighter
	local equipped = itemField(fighter, "EquippedItem")
	if equipped ~= nil then return equipped end
	for _, entry in pairs(getItems() or {}) do
		if itemField(entry, "IsEquipped") == true then return entry end
	end
	return nil
end

local function itemIndex(item)
	return itemField(itemField(item, "Data"), "ItemIndex")
end

local function itemClass(item)
	if item == nil then return nil end
	local class = itemField(itemField(item, "Info"), "Class")
	if class ~= nil then return class end
	local index = itemIndex(item)
	return index and ({ "Primary", "Secondary", "Melee", "Utility" })[index] or nil
end

local function equipItem(item)
	if item == nil then return false end
	if itemField(item, "IsEquipped") == true then return true end
	local fighter = itemField(item, "ClientFighter") or FighterController.LocalFighter
	local index = itemIndex(item)
	if fighter == nil or index == nil then
		return (pcall(function() item:Equip() end))
	end
	if pcall(function() fighter:EquipItem(index) end) then return true end
	return (pcall(function() item:Equip() end))
end

local function findInSlot(class)
	for _, entry in pairs(getItems() or {}) do
		if itemClass(entry) == class then return entry end
	end
	return nil
end

local function firstItem()
	for _, entry in pairs(getItems() or {}) do
		return entry
	end
	return nil
end

local UNDEAD_PATTERNS = { "zombie", "gargoyle", "chombie", "reanimat" }
local function isUndeadName(name)
	local lower = name:lower()
	for _, p in ipairs(UNDEAD_PATTERNS) do
		if lower:find(p, 1, true) then return true end
	end
	return false
end

-- wall check: camera -> target head, only walls block (own char + target ignored)
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude

local function hasLineOfSight(targetModel, headPos)
	local char = lplr.Character
	if not char then return false end
	local camera = ws.CurrentCamera
	local origin = camera and camera.CFrame.Position
	if not origin then return false end
	wallParams.FilterDescendantsInstances = { char, targetModel }
	local hit = ws:Raycast(origin, headPos - origin, wallParams)
	return hit == nil
end

local lastFire = 0
local lastSwitch = 0
local cachedTarget = nil
local lastCacheTime = 0
local CACHE_INTERVAL = 0.15

local function getClosestTarget()
	local now = tick()
	local char = lplr.Character
	local myRoot = char and char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil, nil, nil end

	if now - lastCacheTime < CACHE_INTERVAL and cachedTarget then
		local hum = cachedTarget:FindFirstChildWhichIsA("Humanoid")
		local root = cachedTarget:FindFirstChild("HumanoidRootPart", true)
		local head = cachedTarget:FindFirstChild("Head", true)
		if hum and hum.Health > 0 and root and head and hasLineOfSight(cachedTarget, head.Position) then
			return cachedTarget, root, head
		end
		cachedTarget = nil
	end

	lastCacheTime = now

	local closestModel, closestRoot, closestHead = nil, nil, nil
	local closestDist = HALLOWEEN.MaxDistance
	local seen = {}

	-- recursive: enemies are often nested (Appearance.Head, tower sub-folders)
	for _, inst in ipairs(ws:GetDescendants()) do
		if inst:IsA("Humanoid") and inst.Health > 0 then
			local obj = inst.Parent
			while obj and not obj:IsA("Model") do obj = obj.Parent end
			if obj and obj ~= char and not seen[obj] and not plrs:GetPlayerFromCharacter(obj)
				and isUndeadName(obj.Name) then
				seen[obj] = true
				local pRoot = obj:FindFirstChild("HumanoidRootPart", true)
				local pHead = obj:FindFirstChild("Head", true)
				if pRoot and pHead then
					local dist = (myRoot.Position - pRoot.Position).Magnitude
					if dist < closestDist and hasLineOfSight(obj, pHead.Position) then
						closestDist = dist
						closestModel = obj
						closestRoot = pRoot
						closestHead = pHead
					end
				end
			end
		end
	end

	if HALLOWEEN.Debug and closestModel ~= cachedTarget then
		warn("[Halloween] target: " .. (closestModel and closestModel:GetFullName() or "none"))
	end

	cachedTarget = closestModel
	return closestModel, closestRoot, closestHead
end

local halloweenConn = runS.Heartbeat:Connect(function()
	if not halloweenRunning then return end

	local now = tick()

	-- weapon follows the dropdown; if preferred slot is empty, keep whatever is in hand
	local equipped = getEquippedItem()
	if not equipped or itemClass(equipped) ~= HALLOWEEN.WeaponSlot then
		if now - lastSwitch >= 0.15 then
			local item = findInSlot(HALLOWEEN.WeaponSlot) or (not equipped and firstItem()) or nil
			if item then
				lastSwitch = now
				equipItem(item)
			end
		end
	end
	if not equipped then return end

	-- auto ON: fire at enemies on its own. auto OFF: fire only while LMB is held
	if not HALLOWEEN.AutoShoot and not uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		return
	end

	local targetModel, targetRoot, targetHead = getClosestTarget()
	if not targetModel or not targetHead or not targetRoot then return end

	local char = lplr.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end

	if now - lastFire < HALLOWEEN.FireRate then return end
	lastFire = now

	-- head shot: aim at head with tiny jitter
	local originPos = targetHead.Position + Vector3.new(0, 1, 0)
	local targetPos = targetHead.Position
	local aimCF = CFrame.lookAt(originPos, targetPos)
	local targetCF = targetHead.CFrame

	local randomOffset = Vector3.new(
		(math.random() - 0.5) * 0.02,
		(math.random() - 0.5) * 0.02,
		(math.random() - 0.5) * 0.02
	)
	local aimedPos = targetPos + randomOffset
	local objSpaceHeadOffset = targetHead.CFrame:ToObjectSpace(CFrame.new(aimedPos))

	local cameradata = {}
	cameradata[utf8.char(1)] = {
		[utf8.char(0)] = util:EncodeCFrame(aimCF),
		[utf8.char(1)] = util:EncodeCFrame(targetCF),
		[utf8.char(2)] = targetHead,
		[utf8.char(3)] = util:EncodeCFrame(objSpaceHeadOffset),
	}

	pcall(function()
		repS.Remotes.Replication.Fighter.UseItem:FireServer(
			equipped:Get("ObjectID"),
			enum:ToEnum("StartShooting"),
			cameradata,
			nil
		)
	end)
end)

